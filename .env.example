# =================================
# AURA Hotel Test Configuration
# =================================
# Copy this file to .env and fill in your values

# Email Notifications for Test Failures
# =====================================
# Configure these to receive email alerts when tests fail.
# Uses Gmail SMTP - requires a Gmail App Password (not your regular password)

# Step 1: Enable 2-Factor Authentication on your Google account
# Step 2: Go to https://myaccount.google.com/apppasswords
# Step 3: Generate a new app password for "Mail"
# Step 4: Use that 16-character password below

NOTIFY_EMAIL_TO=your-email@example.com
NOTIFY_EMAIL_FROM=your-gmail@gmail.com
NOTIFY_EMAIL_PASSWORD=your-16-char-app-password

# Headless Mode (optional)
# ========================
# Set to 0 to see the browser during tests
# HEADLESS=0
